# Shared defaults for the Replogle generation runners (source this file, do not execute it).
#
# Paths are RELATIVE to JOB_ROOT, and the runners cd there before generating. That matters:
# generate.py records these strings in .parts/settings.json and refuses to resume when they
# differ, so an absolute path on one machine and a relative one on another would look like a
# settings change and block a legitimate resume.
#
# Expected layout under JOB_ROOT:
#   _artifacts/resubmission/replogle_negative_binomial.{yaml,ckpt}
#   metadata/replogle_train.json
#   outputs/perturbation_direction/replogle/{val,test}_conditions.csv
#   experiments/perturbation_direction/generate.py
#
# Usage:
#   university node : (defaults)
#   this PC         : JOB_ROOT=$PWD PYTHON=$PWD/.venv/bin/python GPUS=0
#   rented GPU      : JOB_ROOT=/workspace/job PYTHON=$(which python) GPUS=0
#
# GPU COUNT may change between runs; BATCH SIZE may not. generate.py seeds noise per batch index,
# so batch 32 over 64 cells is two blocks while batch 16 is four, which changes every cell's noise.

JOB_ROOT=${JOB_ROOT:-/system/user/studentwork/fleischa/scldm_generation_20261020}
PYTHON=${PYTHON:-/system/apps/studentenv/fleischa/miniconda3/envs/scldm/bin/python}
GPUS=${GPUS:-0}
GENERATION_TIMEOUT=${GENERATION_TIMEOUT:-21600}   # per shard, seconds

GENERATE=${GENERATE:-experiments/perturbation_direction/generate.py}
CONFIG=${CONFIG:-_artifacts/resubmission/replogle_negative_binomial.yaml}
CKPT=${CKPT:-_artifacts/resubmission/replogle_negative_binomial.ckpt}
METADATA=${METADATA:-metadata/replogle_train.json}
PRED_DIR=${PRED_DIR:-outputs/perturbation_direction/replogle/pred}

export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}

# Fail early with a readable message instead of a traceback deep inside the loader.
for required in "$GENERATE" "$CONFIG" "$CKPT" "$METADATA"; do
  if [ ! -f "$JOB_ROOT/$required" ]; then
    echo "missing required input: $JOB_ROOT/$required" >&2
    echo "set JOB_ROOT, or override GENERATE/CONFIG/CKPT/METADATA (paths relative to JOB_ROOT)" >&2
    exit 2
  fi
done

# Seeds may be given as "0 1 2" or "0,1,2"; commas avoid the quoting problems that come with
# passing a space-separated list through tmux or a scheduler.
normalize_seeds() {
  local raw="$1"
  echo "${raw//,/ }"
}

# Run generation across ${GPUS}: one process per GPU, each pinned with CUDA_VISIBLE_DEVICES,
# then merge. generate.py's own launcher re-execs children with a per-worker
# CUDA_VISIBLE_DEVICES, which fails with "CUDA unknown error" on nodes where the parent has
# already initialised CUDA (seen on student07). Sharding here avoids that path entirely.
#
# usage: run_generation <out.parquet> <generate.py args...>   (do not pass --gpus/--out)
run_generation() {
  local out="$1"; shift
  local gpus=()
  IFS=',' read -r -a gpus <<< "$GPUS"
  local n=${#gpus[@]}
  local logdir; logdir="$(dirname "$out")/$(basename "$out" .parquet).parts"
  mkdir -p "$logdir"

  if [ "$n" -le 1 ]; then
    CUDA_VISIBLE_DEVICES="${gpus[0]:-0}" timeout "$GENERATION_TIMEOUT" "$PYTHON" -u "$GENERATE" "$@" --device cuda --out "$out"
    return $?
  fi

  local pids=() rc=0 i
  for i in "${!gpus[@]}"; do
    CUDA_VISIBLE_DEVICES="${gpus[$i]}" timeout "$GENERATION_TIMEOUT" "$PYTHON" -u "$GENERATE" "$@" \
      --device cuda --shard "$i" --num-shards "$n" --out "$out" \
      > "$logdir/shard$(printf %03d "$i")of$(printf %03d "$n").log" 2>&1 &
    pids+=("$!")
  done
  for i in "${pids[@]}"; do wait "$i" || rc=1; done
  if [ "$rc" -ne 0 ]; then
    echo "a shard failed; see $logdir" >&2
    return 1
  fi
  timeout 600 "$PYTHON" -u "$GENERATE" "$@" --merge-only --out "$out"
}

# Shared defaults for the Replogle generation runners (source this file, do not execute it).
#
# Everything is overridable so the same scripts run on the university nodes, this PC, or a rented
# box without edits. The only requirement is that JOB_ROOT mirrors the layout the scripts expect:
#
#   $JOB_ROOT/_artifacts/resubmission/replogle_negative_binomial.{yaml,ckpt}
#   $JOB_ROOT/metadata/replogle_train.json
#   $JOB_ROOT/outputs/perturbation_direction/replogle/test_conditions.csv
#   $JOB_ROOT/experiments/perturbation_direction/generate.py
#
# Typical overrides:
#   university node : (defaults)
#   this PC         : JOB_ROOT=$PWD PYTHON=$PWD/.venv/bin/python GPUS=0
#   rented GPU      : JOB_ROOT=/workspace/job PYTHON=$(which python) GPUS=0
#
# GPU COUNT may change between runs; BATCH SIZE may not. generate.py seeds noise per batch index,
# so batch 32 over 64 cells is two blocks while batch 16 is four, which changes every cell's noise.

JOB_ROOT=${JOB_ROOT:-/system/user/studentwork/fleischa/scldm_generation_20261020}
PYTHON=${PYTHON:-/system/apps/studentenv/fleischa/miniconda3/envs/scldm/bin/python}
GPUS=${GPUS:-0}

GENERATE=${GENERATE:-$JOB_ROOT/experiments/perturbation_direction/generate.py}
CONFIG=${CONFIG:-$JOB_ROOT/_artifacts/resubmission/replogle_negative_binomial.yaml}
CKPT=${CKPT:-$JOB_ROOT/_artifacts/resubmission/replogle_negative_binomial.ckpt}
METADATA=${METADATA:-$JOB_ROOT/metadata/replogle_train.json}
PRED_DIR=${PRED_DIR:-$JOB_ROOT/outputs/perturbation_direction/replogle/pred}

export OMP_NUM_THREADS=${OMP_NUM_THREADS:-4}
export MKL_NUM_THREADS=${MKL_NUM_THREADS:-4}
export PYTORCH_CUDA_ALLOC_CONF=${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}

# Fail early with a readable message instead of a traceback deep inside the loader.
for required in "$GENERATE" "$CONFIG" "$CKPT" "$METADATA"; do
  if [ ! -f "$required" ]; then
    echo "missing required input: $required" >&2
    echo "set JOB_ROOT (or the individual CONFIG/CKPT/METADATA/GENERATE overrides)" >&2
    exit 2
  fi
done
